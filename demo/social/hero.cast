[4.25,"o","\r\n\u001b[31m╔══════════════════════════════════════════════════════════╗\u001b[0m\r\n\u001b[31m║\u001b[0m  \u001b[1m\u001b[91mCOMMIT BLOCKED\u001b[0m — No gate session found                 \u001b[31m║\u001b[0m\r\n\u001b[31m╠══════════════════════════════════════════════════════════╣\u001b[0m\r\n\u001b[31m║\u001b[0m                                                          \u001b[31m║\u001b[0m\r\n\u001b[31m║\u001b[0m  Create a gate session and register required reviews     \u001b[31m║\u001b[0m\r\n\u001b[31m║\u001b[0m  before committing. Use the MCP convention-gate tools:   \u001b[31m║\u001b[0m\r\n\u001b[31m║\u001b[0m                                                          \u001b[31m║\u001b[0m\r\n\u001b[31m║\u001b[0m    1. create_gate_session({ description: \"...\" })        \u001b[31m║\u001b[0m\r\n\u001b[31m║\u001b[0m    2. register_gate({ session_id, gate_name, result })   \u001b[31m║\u001b[0m\r\n\u001b[31m║\u001b[0m    3. git commit (this hook checks automatically)        \u001b[31m║\u001b[0m\r\n\u001b[31m║\u001b[0m                                                          \u001b[31m║\u001b[0m\r\n\u001b[31m║\u001b[0m  To bypass: GATE_BYPASS=1 git commit                     \u001b[31m║\u001b[0m\r\n\u001b[31m╚══════════════════════════════════════════════════════════╝\u001b[0m\r\n\r\n"]
